{
	"name": "mesh-ui",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",

		"smui-theme-light": "smui-theme compile static/smui-light.css -i src/static/theme",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/static/theme/dark",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check --plugin-search-dir=. . && eslint .",
		"format": "prettier --write --plugin-search-dir=. ."
	},
	"devDependencies": {
		"@smui-extra/accordion": "^6.0.0-beta.16",
		"@smui-extra/badge": "^6.0.0-beta.16",
		"@smui/button": "^6.0.0-beta.16",
		"@smui/card": "^6.0.0-beta.16",
		"@smui/common": "^6.0.0-beta.16",
		"@smui/data-table": "^6.0.0-beta.16",
		"@smui/dialog": "^6.0.0-beta.16",
		"@smui/drawer": "^6.0.0-beta.16",
		"@smui/form-field": "6.0.0-beta.16",
		"@smui/icon-button": "^6.0.0-beta.16",
		"@smui/layout-grid": "^6.0.0-beta.16",
		"@smui/linear-progress": "^6.0.0-beta.16",
		"@smui/list": "^6.0.0-beta.16",
		"@smui/paper": "^6.0.0-beta.16",
		"@smui/switch": "^6.0.0-beta.16",
		"@smui/tab": "^6.0.0-beta.16",
		"@smui/tab-bar": "^6.0.0-beta.16",
		"@smui/textfield": "^6.0.0-beta.16",
		"@smui/top-app-bar": "^6.0.0-beta.16",
		"@sveltejs/adapter-auto": "next",
		"@sveltejs/kit": "next",
		"@typescript-eslint/eslint-plugin": "^5.27.0",
		"@typescript-eslint/parser": "^5.27.0",
		"unzipper": "^0.10.11",
		"@types/unzipper": "^0.10.5",
		"buffer": "^6.0.3",
		"eslint": "^8.16.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-svelte3": "^4.0.0",
		"prettier": "^2.6.2",
		"prettier-plugin-svelte": "^2.7.0",
		"smui-theme": "^6.0.0-beta.16",
		"svelte": "^3.44.0",
		"svelte-check": "^2.7.1",
		"svelte-preprocess": "^4.10.6",
		"tslib": "^2.3.1",
		"typescript": "^4.7.2",
		"three": "^0.144.0"
	},
	"type": "module"
}
